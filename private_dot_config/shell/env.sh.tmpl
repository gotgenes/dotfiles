# Environment variables shared by zsh (~/.zshenv) and bash (~/.bash_profile,
# ~/.bashrc). One place to add a variable, so the two shells cannot drift.
#
# Compatibility rules — this file is sourced by BOTH zsh and bash:
#   - Plain `export NAME="value"` assignments, `${VAR:-default}`, `case`,
#     `[ ... ]`, and `command -v`.
#   - No arrays (zsh indexes from 1, bash from 0), no `[[ ]]`/`(( ))`, no
#     `$+commands`, and quote every expansion (zsh does not word-split).
#   - No PATH/fpath manipulation; that is shell-specific and lives in
#     zsh/paths.zsh and bash/paths.bash.
# Check with: zsh -n env.sh && bash -n env.sh && shellcheck -s sh env.sh

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

export EDITOR="nvim"

# Static equivalent of the env-var half of `brew shellenv`. Running
# `brew shellenv` costs a ~25ms subprocess in every shell, and it prepends to
# INFOPATH/FPATH unconditionally, so each nested shell added another copy.
# PATH and fpath are handled per shell (paths.zsh, paths.bash, .zshenv).
{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_REPOSITORY="/opt/homebrew"
{{- else }}
export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
export HOMEBREW_REPOSITORY="/home/linuxbrew/.linuxbrew/Homebrew"
{{- end }}
export HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"
# The trailing colon keeps the system default info directories searchable.
case ":${INFOPATH:-}:" in
    *":$HOMEBREW_PREFIX/share/info:"*) ;;
    *) export INFOPATH="$HOMEBREW_PREFIX/share/info:${INFOPATH:-}" ;;
esac

export GOPATH="$HOME/development/go"

if [ -d "$HOMEBREW_PREFIX/opt/dotnet/libexec" ]; then
    export DOTNET_ROOT="$HOMEBREW_PREFIX/opt/dotnet/libexec"
fi

export PTPYTHON_CONFIG_HOME="$XDG_CONFIG_HOME/ptpython"

export PI_ASK_USER_DISPLAY_MODE="inline"
