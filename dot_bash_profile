# Login bash: a terminal tab running bash, `bash -l`, `bash -l -c ...`.
# macOS's /etc/profile has already run path_helper by now, so PATH entries
# prepended here stay in front (see ~/.config/bash/paths.bash).
#
# Docker Desktop may append a `~/.docker/bin` PATH line to this file; it is
# redundant (paths.bash adds that dir) and safe to discard on `chezmoi apply`.

source "$HOME/.config/shell/env.sh"
source "$XDG_CONFIG_HOME/bash/paths.bash"

if [[ $- == *i* ]]; then
    # Interactive setup (prompt, completion, `mise activate`, ...) lives in
    # .bashrc, which login shells do not read on their own.
    source "$HOME/.bashrc"
else
    # Non-interactive login shells get no `mise activate` hooks: resolve tools
    # through mise's shims and apply mise.toml env vars as defaults.
    __mise_shims="${MISE_DATA_DIR:-$XDG_DATA_HOME/mise}/shims"
    if [[ -d "$__mise_shims" ]]; then
        export PATH="$__mise_shims:$PATH"
    fi
    unset __mise_shims
    source "$XDG_CONFIG_HOME/bash/mise_env.bash"
fi
